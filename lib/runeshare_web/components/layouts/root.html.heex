<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:og][:description] ||
          "Share and copy RuneScape 3 Watchdog alarm strings and tile marker presets."
      }
    />
    <meta property="og:site_name" content="RuneShare" />
    <meta property="og:type" content={if assigns[:og], do: "article", else: "website"} />
    <meta property="og:title" content={assigns[:og][:title] || "RuneShare"} />
    <meta
      property="og:description"
      content={
        assigns[:og][:description] ||
          "Share and copy RuneScape 3 Watchdog alarm strings and tile marker presets."
      }
    />
    <meta property="og:url" content={assigns[:og][:url] || Phoenix.Controller.current_url(@conn)} />
    <meta :if={assigns[:og][:image]} property="og:image" content={assigns[:og][:image]} />
    <meta
      name="twitter:card"
      content={if assigns[:og][:image], do: "summary_large_image", else: "summary"}
    />
    <.live_title default="RuneShare" suffix=" · RuneShare" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // Dark by default (set on <html> above); only an explicit "light" choice overrides it.
      (() => {
        const apply = (theme) =>
          document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
        apply(localStorage.getItem("phx:theme"));
        window.addEventListener("storage", (e) => e.key === "phx:theme" && apply(e.newValue));
        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          localStorage.setItem("phx:theme", theme);
          apply(theme);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-300 font-sans text-base-content antialiased">
    {@inner_content}
  </body>
</html>
