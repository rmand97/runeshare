<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={assigns[:og][:description] || default_description()} />
    <meta :if={assigns[:noindex]} name="robots" content="noindex" />
    <link :if={!assigns[:noindex]} rel="canonical" href={canonical_url(assigns)} />
    <meta property="og:site_name" content="RuneShare" />
    <meta property="og:type" content={assigns[:og][:type] || "website"} />
    <meta
      property="og:title"
      content={assigns[:og][:title] || assigns[:page_title] || "RuneShare"}
    />
    <meta
      property="og:description"
      content={assigns[:og][:description] || default_description()}
    />
    <meta property="og:url" content={canonical_url(assigns)} />
    <%!-- Pages without their own image (a preset's cover) share the site card. --%>
    <meta property="og:image" content={assigns[:og][:image] || url(~p"/images/og-default.png")} />
    <meta name="twitter:card" content="summary_large_image" />
    <%!-- Structured data (schema.org JSON-LD) for search engines: data, never run. --%>
    <script :if={assigns[:json_ld]} type="application/ld+json" phx-no-format><%= RuneshareWeb.StructuredData.encode(assigns[:json_ld]) %></script>
    <.live_title default="RuneShare" suffix=" · RuneShare" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="64x64" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script nonce={@conn.assigns[:csp_nonce]}>
      // Dark by default (set on <html> above); only an explicit "light" choice overrides it.
      (() => {
        const apply = (theme) =>
          document.documentElement.setAttribute("data-theme", theme === "light" ? "light" : "dark");
        apply(localStorage.getItem("phx:theme"));
        window.addEventListener("storage", (e) => e.key === "phx:theme" && apply(e.newValue));
        window.addEventListener("phx:set-theme", (e) => {
          const theme = e.target.dataset.phxTheme;
          localStorage.setItem("phx:theme", theme);
          apply(theme);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-300 font-sans text-base-content antialiased">
    {@inner_content}
  </body>
</html>
