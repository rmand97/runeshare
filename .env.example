# Copy to .env and fill in values. .env is gitignored.

# Development slot (0-9) — decides this checkout's ports and database names.
# bin/agent-worktree writes this into each worktree's .env. See `mix runeshare.slot`.
# RUNESHARE_SLOT=0
# RUNESHARE_PORT=4000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/user/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to <endpoint url>/auth
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth

# Comma-separated emails that become admins (moderators) when they sign in.
# ADMIN_EMAILS=you@gmail.com

# Prod only
# PHX_HOST=runeshare.example
# PHX_SERVER=true
# PORT=4000
# SECRET_KEY_BASE=
# TOKEN_SIGNING_SECRET=
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/runeshare_prod
# POOL_SIZE=10
# DNS_CLUSTER_QUERY=
