# Copy to .env and fill in values. .env is gitignored.

# Development slot (0-9) — decides this checkout's ports and database names.
# bin/agent-worktree writes this into each worktree's .env. See `mix runeshare.slot`.
# RUNESHARE_SLOT=0
# RUNESHARE_PORT=4000

# Sign-in providers. Each one's redirect/callback URL is
# http://localhost:4000/auth/user/<provider>/callback (google, github, discord, twitch).
# Leave a provider blank and its button fails to sign in; the others still work.
# Optional per provider: <PROVIDER>_REDIRECT_URI, defaults to <endpoint url>/auth

# Google — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers (New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications (OAuth2 > Redirects)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Twitch — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated emails that become admins (moderators) when they sign in.
# ADMIN_EMAILS=you@gmail.com

# Prod only
# PHX_HOST=runeshare.example
# PHX_SERVER=true
# PORT=4000
# SECRET_KEY_BASE=
# TOKEN_SIGNING_SECRET=
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/runeshare_prod
# POOL_SIZE=10
# DNS_CLUSTER_QUERY=
